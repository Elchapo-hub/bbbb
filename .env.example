# GEMINI_API_KEY: Optional Gemini API key injected by AI Studio runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted application URL injected by AI Studio runtime.
APP_URL="http://localhost:3000"

# SESSION_SECRET: HMAC signing secret for server authentication tokens.
SESSION_SECRET=""

# ADMIN_BOOTSTRAP_PASSCODE: Optional initial admin passcode override.
ADMIN_BOOTSTRAP_PASSCODE=""

# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY: Optional external Supabase project credentials.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# BOT_FX_API_URL: Optional Bank of Tanzania or commercial bank FX feed URL.
BOT_FX_API_URL=""

# Payment provider sandbox/production credentials (kept strictly server-side).
MPESA_API_KEY=""
MPESA_PUBLIC_KEY=""
MIXX_YAS_MERCHANT_KEY=""
AIRTEL_MONEY_CLIENT_SECRET=""
HALOPESA_API_SECRET=""
CARD_PROVIDER_SECRET_KEY=""
WEBHOOK_SIGNING_SECRET=""
